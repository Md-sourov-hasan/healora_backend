{
  "name": "healora-hub-backend",
  "private": true,
  "packageManager": "npm@11.20.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node init && tsdown",
    "composer:deploy": "prisma deploy",
    "composer:dev": "prisma dev",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "node init && tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:composer": "node init && npm run build && npm run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "node init && node dist/server.mjs",
    "start:render": "node init && npm run db:init -- --yes && node dist/server.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "test:authz": "tsx --env-file-if-exists=.env scripts/authz-sweep.ts",
    "test:auth": "tsx --env-file-if-exists=.env scripts/test-auth-flow.ts",
    "test:e2e": "tsx --env-file-if-exists=.env scripts/e2e-journey.ts",
    "bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "docs:openapi": "tsx --env-file-if-exists=.env scripts/openapi.ts",
    "docs:routes": "tsx --env-file-if-exists=.env scripts/routes.ts > docs/ROUTES.md"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@prisma/composer": "0.35.0",
    "@prisma/composer-prisma-cloud": "0.35.0",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "alchemy": "2.0.0-beta.83",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.17.14",
    "temporal-polyfill": "^1.0.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^26.6.5",
    "prisma": "8.0.0-rc.28",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.3",
    "@effect/platform-bun": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@effect/sql-d1": "4.0.3",
    "@effect/sql-sqlite-do": "4.0.3",
    "@effect/vitest": "4.0.3",
    "@vitejs/devtools": "0.7.6"
  }
}
