// use prisma-8

// =============================================================================
// Healora Hub Management Platform — data contract
// Source: Healora_Hub_Management_PRD.md (3 Nov 2026)
//
// Postgres schemas (namespaces) mirror the PRD's ownership boundaries so that
// database grants can enforce them too (PRD §5.2 rule 5, §10.1):
//
//   identity  — staff accounts, scoped role assignments, credentials, break-glass
//   hub       — regions, hubs, sessions, capacity, rosters, stations, equipment,
//               bookings, queue, operational exceptions   (operational data)
//   clinical  — patients, caregivers, consent, protocols, encounters,
//               observations, reviews, notes                (sensitive health data)
//   ops       — audit log, domain-event outbox, sync ledger, devices,
//               notifications, exports
//
// Conventions
//   * Every id is a UUIDv7. Clients may supply their own id on create (the
//     explicit value wins over @onCreate) — the mobile app relies on this for
//     stable, offline-generated observation ids (PRD §9.9, §10.6).
//   * Instants are timestamptz stored/rendered via TimestamptzString; the API
//     layer renders them in the hub's timezone (Asia/Dhaka).
//   * Clinical rows are append-only/versioned: corrections create a new row
//     pointing at the one it supersedes. Nothing in `clinical` is hard-deleted.
//   * Only the owning side of each relation is declared; Prisma derives the
//     back-references.
// =============================================================================

types {
  Id        = Uuid @onCreate(uuid(7))
  Ref       = Uuid
  Instant   = TimestamptzString
  CreatedAt = TimestamptzString @onCreate(now())
  UpdatedAt = TimestamptzString @onCreate(now()) @onUpdate(now())
}

model mixin Timestamps {
  createdAt CreatedAt @map("created_at")
  updatedAt UpdatedAt @map("updated_at")
}

