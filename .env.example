# Copy to `.env`. Replace the placeholder values before use.

# ---- database -------------------------------------------------------------------
# REQUIRED. PostgreSQL >= 15. Production health data must be hosted in Bangladesh (PRD §17.2).
# Supabase: use the SESSION pooler (port 5432), not the 6543 transaction pooler, and verify TLS with the
# Supabase root CA committed in certs/ (path relative to the working directory):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-prod-ca-2021.crt
POSTGRES_DB=healora
POSTGRES_USER=healora
POSTGRES_PASSWORD=replace-with-a-strong-local-db-password
POSTGRES_PORT=5432
APP_PORT=3000
DATABASE_URL="postgresql://healora:replace-with-a-strong-local-db-password@localhost:5432/healora"

# ---- secrets (REQUIRED, >= 32 random chars each, all different) --------------------
# Signs access tokens (HS256).
JWT_SECRET="replace-with-a-long-random-secret-0000000000"
# Encrypts TOTP secrets at rest (AES-256-GCM). Falls back to JWT_SECRET — don't rely on that.
AUTH_ENCRYPTION_KEY="replace-with-another-long-random-secret-000"
# Keyed hash for national IDs / identifiers / phone numbers / OTP codes. Rotating it invalidates stored hashes.
IDENTIFIER_HASH_KEY="replace-with-a-third-long-random-secret-0000"

# ---- HTTP -------------------------------------------------------------------------
PORT=3000
# Browser origins allowed to call the API (hub website, patient web app).
CORS_ORIGINS="https://healoraweb.vercel.app,http://localhost:5173"
NODE_ENV="development"

# ---- authentication policy ----------------------------------------------------------
# Privileged roles (platform admin, regional ops, clinical ops) must sign in with MFA.
REQUIRE_MFA_FOR_PRIVILEGED="true"
ACCESS_TOKEN_TTL_SEC=900
# Shared hub computers: staff sessions end after 30 min idle, 12 h max.
STAFF_SESSION_IDLE_MIN=30
STAFF_SESSION_MAX_HOURS=12
PATIENT_SESSION_IDLE_DAYS=30
PATIENT_SESSION_MAX_DAYS=90
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
OTP_TTL_SEC=300
# DEVELOPMENT ONLY: enables POST /api/v1/dev/token and session-less tokens. Ignored when NODE_ENV=production.
AUTH_DEV_TOKENS="false"

# ---- background workers ("off" disables in this process; run them in exactly the processes you want) ----
OUTBOX_RELAY="on"
OUTBOX_INTERVAL_MS=1500
NOTIFICATION_DISPATCH="on"
NOTIFICATION_INTERVAL_MS=5000
EXCEPTION_SCAN="on"
REMINDERS="on"
REMINDER_HOURS=24

# ---- operational thresholds -----------------------------------------------------------
# Minutes before the exception scanner raises an item (PRD §8.10). Tune during the pilot.
EXC_UNASSIGNED_MIN=10
EXC_WAIT_MIN=45
EXC_TASK_MIN=30
EXC_REVIEW_MIN=60
EXC_SYNC_PENDING_MIN=30
# Patients may cancel / reschedule until this many minutes before the session.
PATIENT_CANCEL_CUTOFF_MINUTES=60
# Radius for "nearby hubs" when the patient app sends coordinates (never stored).
PATIENT_NEARBY_KM=25
# Allow check-in on a day other than the session date (testing only).
ALLOW_OFF_DAY_CHECKIN="false"
TRUST_PROXY_HOPS=1
# Multiplies the per-IP limits on login/OTP endpoints (hubs share one NAT'd IP). Per-account limits are fixed.
AUTH_IP_LIMIT_FACTOR=1
# TEST ONLY: append "phone code" lines for OTPs to this file so e2e tests can sign patients in. Ignored in production.
# OTP_TEST_SINK_FILE=/tmp/healora-otp.log

# Swagger UI at /docs (spec: docs/openapi.json, regenerate with `npm run docs:openapi`).
# Default: on outside production, off in production.
# API_DOCS=on
